# Biến môi trường cho dịch vụ LLM (thư mục llm\).
# Các cấu hình khác (mô hình, trọng số, ngưỡng điểm...) nằm trong matching\config.py.

# ===================== CHẾ ĐỘ CHẠY =====================
# development: chạy toàn bộ mô hình trên máy (Ollama + bge-m3 PyTorch + reranker), cần ~8GB RAM.
# production:  VPS ~6GB RAM: LLM và reranker qua API, bge-m3 PyTorch giống development (~2GB RAM).
#              Cài bằng: pip install -r requirements-prod.txt (xem ghi chú torch CPU trong file), chạy uvicorn 1 worker.
APP_ENV=development

# ===================== LLM =====================
# Mặc định theo APP_ENV (development = ollama, production = api). Bỏ comment để ghi đè.
# LLM_BACKEND=api

# Ghi đè tên mô hình. Ollama: mặc định qwen2.5:3b. API: mặc định deepseek-chat / gpt-4.1-mini.
# LLM_MODEL=

# Số token đầu ra tối đa; thời gian chờ (giây, mặc định 60 với API, 300 với Ollama)
# LLM_MAX_TOKENS=2048
# LLM_TIMEOUT=60
# Để trống (LLM_TEMPERATURE=) thì không gửi temperature (cho mô hình chỉ nhận giá trị mặc định)
# LLM_TEMPERATURE=0

# -- Ollama (development) --
# Chạy Ollama trên máy thì giữ nguyên;
# nếu llm chạy trong Docker còn Ollama chạy trên máy host thì dùng http://host.docker.internal:11434
OLLAMA_HOST_URL=http://localhost:11434

# -- API (production) --
# Provider chính: deepseek hoặc openai. Provider dự phòng được gọi khi provider chính lỗi (để trống = không dùng).
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_MODEL=
# OPENAI_API_KEY=
# Số lần SDK tự gọi lại khi lỗi mạng, 429, 5xx
# LLM_MAX_RETRIES=3

# ===================== EMBEDDING / RERANKER =====================
# Embedding: torch (fp32, ~2GB RAM, mặc định cả hai chế độ) | onnx (int8, ~0.9GB RAM, cho VPS RAM thấp ~2GB).
# EMBED_BACKEND=torch

# Reranker: torch (trên máy, thêm ~3GB RAM) | api (SiliconFlow...) | none (tắt).
# Mặc định: development = torch; production = api nếu có RERANK_API_KEY, không thì none.
# RERANK_BACKEND=api
# Chỉ rerank N job có điểm sơ bộ (kỹ năng, chức danh, kinh nghiệm...) cao nhất; job còn lại chấm không có rerank.
# Reranker torch trên CPU ~1.2s/job. 0 = rerank tất cả.
# RERANK_TOP_N=150
# Key SiliconFlow (https://cloud.siliconflow.com). Tài khoản bản Trung Quốc thì đổi URL sang https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=
# RERANK_API_URL=https://api.siliconflow.com/v1/rerank
# Mặc định: torch = BAAI/bge-reranker-v2-m3; api = Qwen/Qwen3-Reranker-0.6B (tốt hơn: Qwen/Qwen3-Reranker-8B)
# RERANK_MODEL=
# RERANK_API_TIMEOUT=30
# Số luồng CPU cho PyTorch/ONNX; trên VPS nên đặt số vCPU - 1 để chừa CPU cho Go/Postgres
# CPU_THREADS=3
# Mặc định 1024 / 8; VPS RAM thấp thì giảm còn 512 / 4
# EMBED_MAX_SEQ=1024
# EMBED_BATCH=8

# ===================== HUGGING FACE =====================
# Thư mục lưu mô hình. Windows không đặt thì dùng D:\llm_setup\huggingface; Linux dùng ~/.cache/huggingface.
# Xoá hẳn dòng này (không để giá trị rỗng) để dùng mặc định.
HF_HOME=D:\llm_setup\huggingface

# Tắt cảnh báo symlink của Hugging Face trên Windows
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# 1 = chỉ dùng mô hình đã có trong HF_HOME, không kết nối Hugging Face (mặc định trong config.py).
# Đặt 0 khi cần tải mô hình lần đầu (máy mới, VPS, container Docker chưa có cache) hoặc khi đổi sang mô hình khác.
# Lần đầu tải BAAI/bge-m3 (~2.3GB); EMBED_BACKEND=onnx thì tải Xenova/bge-m3 (~570MB).
HF_HUB_OFFLINE=1
