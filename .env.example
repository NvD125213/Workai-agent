# Biến môi trường cho docker-compose.yml ở thư mục gốc (toàn bộ hệ thống).
#   cp .env.example .env   rồi điền các giá trị bắt buộc (đánh dấu [BẮT BUỘC]).
# Dev local không dùng Docker thì xem backend/.env.example và llm/.env.example.

# ===================== BACKEND (Go) =====================
# development: không có SMTP thì email OTP chỉ in ra log.
# production : bắt buộc điền SMTP_* bên dưới, nếu không api sẽ không khởi động.
APP_ENV=development
# Port api mở ra máy host
HTTP_PORT=8080
TZ=Asia/Ho_Chi_Minh

# PostgreSQL (pgvector). Đổi mật khẩu khi deploy thật.
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=notification_job
# Port DB mở ra host (chỉ 127.0.0.1)
DB_PORT=5433

# [BẮT BUỘC] tối thiểu 32 byte, tạo bằng: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ISSUER=notification-job-mb
JWT_ACCESS_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=7
# IP/CIDR proxy tin cậy (vd nginx), phân tách bằng dấu phẩy
TRUSTED_PROXIES=

# SMTP gửi OTP (bắt buộc khi APP_ENV=production). Cổng 465 = TLS, còn lại STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Telegram bot (để trống token = tắt)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Worker cào job theo lịch
CRAWL_ENABLED=true
CRAWL_KEYWORDS=golang
CRAWL_SOURCES=
CRAWL_INTERVAL_HOURS=3
CRAWL_MAX_PAGES=5
CRAWL_RUN_ON_START=false
DATA_POLL_INTERVAL_SECONDS=30
DATA_IMPORT_MAX_ATTEMPTS=5

# find-job
FIND_JOB_MAX_PAGES=3
FIND_JOB_MAX_CONCURRENT=3
FIND_JOB_SCORE_TIMEOUT_MINUTES=30

# LinkedIn qua WireGuard. LINKEDIN_WG_CONFIG = đường dẫn file .conf trên máy host
# (tương đối so với thư mục gốc, vd ./secrets/wg.conf). File .conf đã bị .gitignore chặn.
LINKEDIN_ENABLED=false
LINKEDIN_WG_CONFIG=

# ===================== AI SERVICE (llm, Python) =====================
# production : LLM + reranker qua API (cần DEEPSEEK_API_KEY), embedding bge-m3 chạy trong container (~2-3GB RAM).
# development: LLM chạy bằng Ollama -> khởi động thêm: docker compose --profile ollama up -d
AI_APP_ENV=production

LLM_PROVIDER=deepseek
# [BẮT BUỘC khi AI_APP_ENV=production]
DEEPSEEK_API_KEY=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
OPENAI_API_KEY=
# Ghi đè model / backend (để trống = mặc định theo AI_APP_ENV)
LLM_BACKEND=
LLM_MODEL=
# Ollama trong compose (profile ollama). Ollama chạy trên host: http://host.docker.internal:11434
OLLAMA_HOST_URL=http://ollama:11434

# Embedding: torch (~2GB RAM) | onnx (~0.9GB RAM, VPS yếu)
EMBED_BACKEND=torch
# Reranker: api (cần RERANK_API_KEY, SiliconFlow) | torch (+~3GB RAM) | none
RERANK_BACKEND=
RERANK_API_KEY=
RERANK_TOP_N=150
# Số luồng CPU cho model (nên = số vCPU - 1)
CPU_THREADS=

# 0 = cho phép tải model ở lần chạy đầu (bge-m3 ~2.3GB, lưu vào volume hf_models).
# Sau khi đã tải xong có thể đặt 1 để không gọi Hugging Face nữa.
HF_HUB_OFFLINE=0
