APP_ENV=development
HTTP_ADDR=:8080
# Port map ra máy host khi chạy docker compose (api)
HTTP_PORT=8080

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=notification_job
DB_SSLMODE=disable

# JWT — JWT_ACCESS_SECRET bắt buộc, tối thiểu 32 byte (vd: openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_ISSUER=notification-job-mb
JWT_ACCESS_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=7
# SMTP cho hàng đợi email chạy nền trong API (gửi OTP). Để trống SMTP_HOST ở môi trường dev = chỉ log email ra console.
# Production bắt buộc đặt. Cổng 465 = TLS ngầm định, còn lại bắt buộc STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Danh sách IP/CIDR proxy tin cậy (phân tách bằng dấu phẩy). Để trống = không tin X-Forwarded-For.
TRUSTED_PROXIES=
# Worker: thư mục AI service ghi file job đã phân tích (data/inbox/*.json), chu kỳ quét (giây),
# số lần thử lại khi lỗi DB trước khi chuyển file sang data/failed/.
DATA_DIR=data
DATA_POLL_INTERVAL_SECONDS=30
DATA_IMPORT_MAX_ATTEMPTS=5
# Worker: tự động chạy các adapter cào job theo lịch (mặc định 3 tiếng/lần, căn theo 00:00, 03:00, ...),
# tối đa CRAWL_MAX_PAGES trang/keyword. Job mới ghi vào DATA_DIR/raw/ cho AI service phân tích.
# CRAWL_SOURCES trống = tất cả (topcv,itviec,jobsgo,indeed,vietnamworks,careerviet,joboko,vieclam24h,123job,careerlink, thêm linkedin nếu LINKEDIN_ENABLED=true).
# Danh sách phân tách bằng dấu phẩy.
CRAWL_ENABLED=true
CRAWL_KEYWORDS=golang
CRAWL_SOURCES=
CRAWL_INTERVAL_HOURS=3
CRAWL_MAX_PAGES=5
CRAWL_RUN_ON_START=false
# LinkedIn (worker cào theo lịch + API find-job). Mặc định tắt: nhà mạng Việt Nam chặn LinkedIn, nguồn bị chặn
# làm mỗi lượt tìm phải chờ LinkedIn thử lại vài phút.
# LINKEDIN_WG_CONFIG: đường dẫn file .conf WireGuard (định dạng wg-quick, lấy từ nhà cung cấp VPN hoặc server riêng).
# Chỉ request tới LinkedIn (kể cả DNS) đi qua VPN, chạy ngay trong process, không cần cài WireGuard hay quyền admin.
# Để trống = kết nối trực tiếp (server đặt ở nước ngoài).
LINKEDIN_ENABLED=false
LINKEDIN_WG_CONFIG=
# API: service AI nội bộ (llm/api.py) cho parse-cv, analyze-cv, find-job.
# Chạy: cd llm && .venv\Scripts\python.exe -m uvicorn api:app --host 127.0.0.1 --port 8001
AI_SERVICE_URL=http://127.0.0.1:8001
# find-job: số trang tìm kiếm mỗi nguồn, số lượt tìm chạy cùng lúc (các lượt khác chờ ở QUEUED).
# Mỗi lượt cào 5 nguồn song song; các lượt chạy cùng lúc dùng chung giới hạn request của từng trang
# nên không làm tăng tải lên trang tuyển dụng, chỉ cho lượt này cào trong lúc lượt khác đang chấm điểm.
FIND_JOB_MAX_PAGES=3
FIND_JOB_MAX_CONCURRENT=3
# Thời gian tối đa (phút) chờ AI service chấm điểm một lượt tìm việc; vượt quá thì lượt đó báo lỗi.
FIND_JOB_SCORE_TIMEOUT_MINUTES=30
# Bot Telegram để worker gửi thông báo. Để trống TELEGRAM_BOT_TOKEN = tắt.
# TELEGRAM_CHAT_ID: id user/group/channel (group/channel thường bắt đầu bằng -100); bot phải ở trong chat đó.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
